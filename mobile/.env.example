# ─── اہلِ فن — Local Development Environment Variables ──────────────────────
# Copy this file to .env and fill in your keys for local Expo development.
# For EAS Cloud builds, set these via: eas secret:create
#
# DO NOT commit the .env file — it is in .gitignore

# Groq API key (primary AI backend — ultra fast inference)
# Get yours free at: https://console.groq.com
EXPO_PUBLIC_GROQ_API_KEY=gsk_...your_groq_key_here...

# Google Gemini API key (fallback AI backend)
# Get yours free at: https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=AIza...your_gemini_key_here...
