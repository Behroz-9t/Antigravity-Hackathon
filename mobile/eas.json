{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_GEMINI_API_KEY": "secret:EXPO_PUBLIC_GEMINI_API_KEY",
        "EXPO_PUBLIC_GROQ_API_KEY": "secret:EXPO_PUBLIC_GROQ_API_KEY"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_GEMINI_API_KEY": "secret:EXPO_PUBLIC_GEMINI_API_KEY",
        "EXPO_PUBLIC_GROQ_API_KEY": "secret:EXPO_PUBLIC_GROQ_API_KEY"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_GEMINI_API_KEY": "secret:EXPO_PUBLIC_GEMINI_API_KEY",
        "EXPO_PUBLIC_GROQ_API_KEY": "secret:EXPO_PUBLIC_GROQ_API_KEY"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
